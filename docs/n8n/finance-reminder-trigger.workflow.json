{
  "name": "finance-system-reminder-trigger",
  "nodes": [
    {
      "parameters": {
        "path": "finance/reminder-trigger",
        "responseMode": "lastNode",
        "httpMethod": "POST"
      },
      "id": "Webhook_Trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.headers.authorization || ''}}",
              "operation": "contains",
              "value2": "Bearer "
            }
          ]
        }
      },
      "id": "Auth_Guard",
      "name": "Auth Guard",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const body = $json.body || {};\nreturn [{\n  json: {\n    ok: true,\n    reminderId: body.reminderId,\n    title: body.title,\n    message: body.message,\n    channel: body.channel,\n    triggeredAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "Normalize_Payload",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        830,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
      "id": "Webhook_Response_Success",
      "name": "Webhook Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1090,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'Unauthorized webhook token' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "Webhook_Response_Unauthorized",
      "name": "Webhook Response Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        840,
        430
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Auth Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth Guard": {
      "main": [
        [
          {
            "node": "Normalize Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Webhook Response Unauthorized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Payload": {
      "main": [
        [
          {
            "node": "Webhook Response Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
