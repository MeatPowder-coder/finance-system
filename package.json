{
  "name": "finance-system",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @finance-system/web dev",
    "dev:api": "pnpm --filter @finance-system/api dev",
    "dev:api:nowatch": "pnpm --filter @finance-system/api dev:nowatch",
    "dev:desktop": "pnpm --filter @finance-system/desktop dev",
    "dev:desktop:tauri": "pnpm --filter @finance-system/desktop dev:tauri",
    "build": "pnpm -r build",
    "build:desktop:tauri": "pnpm --filter @finance-system/desktop build:tauri",
    "typecheck": "pnpm -r typecheck",
    "test:integration": "pnpm --filter @finance-system/api test:integration",
    "db:up": "docker compose -f docker-compose.local.yml up -d",
    "db:down": "docker compose -f docker-compose.local.yml down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import:legacy": "node scripts/db-import-legacy.mjs",
    "hasura:up": "docker compose -f docker-compose.hasura.local.yml --env-file .env.vm up -d",
    "hasura:down": "docker compose -f docker-compose.hasura.local.yml --env-file .env.vm down",
    "hasura:ps": "docker compose -f docker-compose.hasura.local.yml --env-file .env.vm ps",
    "hasura:logs": "docker compose -f docker-compose.hasura.local.yml --env-file .env.vm logs -f hasura-finance-local",
    "hasura:apply": "node scripts/hasura-apply-metadata.mjs",
    "hasura:export": "node scripts/hasura-export-metadata.mjs",
    "vm:up": "docker compose -f docker-compose.vm.yml --env-file .env.vm up -d --build",
    "vm:down": "docker compose -f docker-compose.vm.yml --env-file .env.vm down",
    "vm:ps": "docker compose -f docker-compose.vm.yml --env-file .env.vm ps",
    "vm:deploy": "node scripts/vm-deploy.mjs",
    "bootstrap": "pnpm install && pnpm db:up && pnpm db:migrate",
    "agent:bootstrap-demo": "node scripts/agent-bootstrap-demo.mjs"
  },
  "dependencies": {
    "pg": "^8.18.0"
  }
}
