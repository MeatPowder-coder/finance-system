{
  "name": "@finance-system/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env.local --import tsx --watch src/index.ts",
    "dev:nowatch": "node --env-file=../../.env.local --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "set NODE_ENV=test&& node --import tsx --test src/db.test.ts src/commitments.test.ts",
    "test:integration": "set NODE_ENV=test&& node --env-file=../../.env.local --import tsx --test src/index.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@mastra/core": "^1.37.1",
    "@mastra/mcp": "^1.8.1",
    "fastify": "^5.6.2",
    "jose": "^5.10.0",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/pg": "^8.16.0",
    "tsx": "^4.20.6",
    "typescript": "5.4.5"
  }
}
