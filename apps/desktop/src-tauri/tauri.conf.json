{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinanceSystem",
  "version": "0.1.0",
  "identifier": "com.financesystem.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --config vite.config.cjs --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --config vite.config.cjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FinanceSystem",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../../web/app/favicon.ico"]
  }
}
