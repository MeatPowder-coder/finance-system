{
  "name": "@finance-system/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --config vite.config.cjs --host 0.0.0.0 --port 1420",
    "dev:tauri": "tauri dev",
    "build": "tsc --noEmit && node node_modules/vite/bin/vite.js build --config vite.config.cjs",
    "build:local-preview": "tsc --noEmit && node node_modules/vite/bin/vite.js build --mode local-preview --config vite.config.cjs",
    "preview:local": "node node_modules/vite/bin/vite.js preview --mode local-preview --config vite.config.cjs --host 0.0.0.0 --port 4176 --strictPort",
    "build:tauri": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tauri-apps/api": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@tauri-apps/cli": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "5.4.5",
    "vite": "^5.4.0"
  }
