# --- Database (local default) ---
# Local Docker Postgres (docker-compose.local.yml) maps 5434 -> 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/finance_system

# Optional legacy source for migration/import scripts
# Example VM same host engine with separate DB:
LEGACY_DATABASE_URL=postgresql://root:CHANGE_ME@localhost:5432/finanzas

# --- API ---
API_HOST=0.0.0.0
API_PORT=4100
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:1420

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=https://finance-api.agentame.xyz

# --- Desktop ---
VITE_API_BASE_URL=https://finance-api.agentame.xyz
VITE_WEB_APP_URL=http://localhost:3005

# --- Copilot AI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
COPILOT_DEFAULT_MODEL=gemini-2.5-flash-lite
COPILOT_MODELS=gemini-3.1-flash-lite-preview,gemini-2.5-flash-lite,glm-5.1,kimi-k2.5,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-pro,gpt-5.2,gpt-5.2-pro,gpt-5-mini,gpt-5-nano,gpt-4.1-mini,gpt-4.1,gpt-4o-mini

# Google Gemini provider
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias para Mastra model-router (puede ser el mismo valor de GOOGLE_GENERATIVE_AI_API_KEY)
GOOGLE_API_KEY=

# NVIDIA NIM provider
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
GLM_MODEL_ID=z-ai/glm-5.1
KIMI_MODEL_ID=moonshotai/kimi-k2.5

# --- Agent Runtime (Mastra-ready) ---
AGENT_RUNTIME_ENABLED=true
AGENT_RUNTIME_PROVIDER=internal
AGENT_DEFAULT_NAME=FinanceSupervisorAgent
AGENT_DEFAULT_CHANNEL=WEB
AGENT_REQUIRE_APPROVAL_FOR_WRITE=true
AGENT_ALLOW_CODE_CHANGE_PROPOSALS=true
AGENT_DASHBOARD_AUTOPUBLISH=false

# --- Telegram remote front door (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- MCP finance bridge ---
MCP_FINANCE_ENABLED=true
MCP_FINANCE_PATH=/mcp

# --- MCP bridge ---
MCP_FINANCE_ENABLED=false
MCP_FINANCE_HOST=0.0.0.0
MCP_FINANCE_PORT=4310

# --- n8n bridge ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# --- Hasura (local) ---
HASURA_GRAPHQL_ENDPOINT=http://localhost:8086
HASURA_GRAPHQL_ADMIN_SECRET=change_me
# If Hasura runs in Docker, host.docker.internal reaches your host Postgres port
HASURA_GRAPHQL_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5434/finance_system

# --- Auth propia ---
# AUTH_JWT_SECRET es la clave principal para firmar sesiones.
# NEXTAUTH_SECRET se mantiene como fallback compatible si ya lo usabas.
AUTH_JWT_SECRET=change_me
NEXTAUTH_SECRET=change_me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
